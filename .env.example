# Copy this file to .env. Never commit real credentials.
POSTGRES_DB=inovasix_flow
POSTGRES_USER=inovasix_flow
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_PORT=5432
REDIS_PORT=6379

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Runtime uses the least-privilege application role (NOSUPERUSER, NOBYPASSRLS,
# non-owner). RLS enforces tenant isolation on this connection.
DATABASE_URL=postgresql://inovasix_app:replace_with_a_local_secret@localhost:5432/inovasix_flow?schema=public

# Owner role for DDL/migrations only (never used at runtime).
DATABASE_URL_OWNER=postgresql://inovasix_owner:replace_with_a_local_secret@localhost:5432/inovasix_flow?schema=public

# Integration tests connect as the application role to exercise real RLS.
DATABASE_URL_APP=postgresql://inovasix_app:replace_with_a_local_secret@localhost:5432/inovasix_flow?schema=public

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
LOG_LEVEL=info
NODE_ENV=development

# Machine-to-machine credentials for POST /api/conversations/inbound: a JSON
# array (single-quote it). Each entry binds a keyId to ONE tenant and ONE
# channel (WHATSAPP | INSTAGRAM | FACEBOOK | WEBCHAT); the request body never
# chooses either. secret: >= 32 random characters, e.g. `openssl rand -hex 32`.
# Empty ([]) disables the endpoint. Shape of one entry (fill in real values in
# your own .env, never here):
#   '[{"keyId":"<keyId>","tenantId":"<tenant uuid>","channel":"WHATSAPP","secret":"<32+ random chars>"}]'
INBOUND_SERVICE_CREDENTIALS='[]'

# Optional: text of the automatic reply a new conversation gets on its first
# contact, before a person takes over (max 4000 characters). Unset/blank uses
# the built-in Portuguese acknowledgement. Same text for every tenant.
# FIRST_CONTACT_MESSAGE=

# Outbound delivery engine (OUTBOUND + PENDING messages -> channel adapter).
# The polling worker is OFF unless enabled. With no channel adapter registered
# (none exists yet: no real provider is integrated) messages just stay PENDING.
# Retry policy (5 attempts, 1 min / 5 min / 15 min / 1 h) is fixed in code, not env.
# OUTBOUND_WORKER_ENABLED=false
# OUTBOUND_POLL_INTERVAL_MS=2000      # pause between polls when idle (200..3600000)
# OUTBOUND_BATCH_SIZE=10              # messages claimed per tenant per poll (1..50)
# OUTBOUND_LEASE_MS=60000             # how long a claimed message is reserved (5000..600000)
# OUTBOUND_SEND_TIMEOUT_MS=15000      # limit for one adapter send; must be < OUTBOUND_LEASE_MS

# WhatsApp Cloud API (Meta). OFF by default: while WHATSAPP_CLOUD_ENABLED is not
# "true" the webhook answers 404 and no outbound adapter is registered, so adding
# these variables can never send real messages by accident. When enabled the app
# refuses to boot if any secret below is missing or weak.
# One Meta App for the whole platform (global): its App Secret signs every
# webhook (X-Hub-Signature-256); the verify token is the string you type into the
# Meta dashboard for the GET handshake. Generate both, e.g. `openssl rand -hex 32`.
# WHATSAPP_CLOUD_ENABLED=false
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Per tenant, explicit: the webhook's phone_number_id resolves the tenant ONLY from
# this list (never from the request), and the outbound adapter sends from it. One
# account per tenant. JSON array, single-quoted; fill in real values in your own
# .env, never here:
#   '[{"tenantId":"<tenant uuid>","phoneNumberId":"<Meta phone_number_id>","accessToken":"<token>"}]'
# WHATSAPP_CLOUD_ACCOUNTS='[]'
# Graph API version (v25.0 is what Meta's docs show as current) and host. Tests
# point the base URL at a local fake; http:// is refused in production.
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_HTTP_TIMEOUT_MS=10000      # per Graph API call; must be < OUTBOUND_SEND_TIMEOUT_MS
