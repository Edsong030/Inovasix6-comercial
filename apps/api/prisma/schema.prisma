generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (one value per line — Prisma requires this)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RoleCode {
  ADMIN
  GESTOR
  COMERCIAL
  ATENDENTE
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum ConversationState {
  AI_ATENDENDO
  AGUARDANDO_HUMANO
  HUMANO_ATENDENDO
  ENCERRADA
}

// Channel the conversation is happening on. Only MANUAL is actually usable
// today (no provider integration yet) — the others exist so the domain does
// not need a schema change when a real integration is added.
enum ConversationChannel {
  MANUAL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBCHAT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Who/what authored the message. AI exists structurally for the future
// assistant hand-off; nothing writes it yet.
enum MessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
  AI
}

enum FollowUpType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CalendarEventType {
  MEETING
  CALL
  TASK
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

// ---------------------------------------------------------------------------
// Multi-tenant FK integrity strategy
// ---------------------------------------------------------------------------
// Every tenant-owned parent exposes @@unique([tenantId, id]). Children that
// reference a parent do so with a COMPOSITE foreign key [tenantId, <parentId>]
// -> [tenantId, id], reusing the SAME tenantId column that also anchors the
// child's own relation to Tenant. This makes it physically impossible at the
// database level for a child row to reference a parent belonging to a
// different tenant: the shared tenantId must match on both sides.
//
// Prisma supports sharing a scalar field between multiple relations, so
// tenantId participates in both (a) the relation to Tenant and (b) each
// composite FK. RLS + application predicates remain in place as further layers.
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                    User[]
  roles                    Role[]
  userRoles                UserRole[]
  authSessions             AuthSession[]
  contacts                 Contact[]
  contactChannelIdentities ContactChannelIdentity[]
  pipelines                Pipeline[]
  pipelineStages           PipelineStage[]
  leads                    Lead[]
  conversations            Conversation[]
  messages                 Message[]
  auditLogs                AuditLog[]
  followUps                FollowUp[]
  calendarEvents           CalendarEvent[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  name         String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles             UserRole[]
  authSessions          AuthSession[]
  ownedLeads            Lead[]          @relation("LeadOwner")
  ownedFollowUps        FollowUp[]      @relation("FollowUpOwner")
  ownedCalendarEvents   CalendarEvent[] @relation("CalendarEventOwner")
  assignedConversations Conversation[]  @relation("ConversationAssignee")
  sentMessages          Message[]       @relation("MessageSender")

  // Enables composite FKs [tenantId, id] from children (AuthSession, UserRole, Lead.owner, FollowUp.owner, CalendarEvent.owner, Conversation.assignedUser, Message.senderUser).
  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      RoleCode
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Both FKs share tenantId, so user and role are forced into the same tenant.
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // Only the hash of the refresh token is stored, never the token itself.
  refreshTokenHash String    @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite FK: tenantId is shared, so a session cannot bind a user from another tenant.
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Active-session lookups and rotation/revocation checks.
  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// CRM core (Lead represents the Opportunity during the MVP)
// ---------------------------------------------------------------------------

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String?
  phoneE164 String?  @map("phone_e164")
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads             Lead[]
  conversations     Conversation[]
  channelIdentities ContactChannelIdentity[]

  @@unique([tenantId, id])
  @@unique([tenantId, phoneE164])
  @@index([tenantId, email])
  @@map("contacts")
}

// Maps a channel-specific external identifier (WhatsApp wa_id, Webchat
// visitorId, Instagram-scoped user id, ...) to an internal Contact. Kept as
// its own table — rather than columns on Contact — because the same person
// can be reachable on several channels at once, and each new channel would
// otherwise need another nullable column on Contact that most rows never use.
model ContactChannelIdentity {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  contactId         String              @map("contact_id") @db.Uuid
  channel           ConversationChannel
  externalContactId String              @map("external_contact_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite FK keeps the identity's contact within the same tenant.
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  // One external id per channel resolves to exactly one Contact, per tenant.
  @@unique([tenantId, channel, externalContactId])
  @@index([tenantId, contactId])
  @@map("contact_channel_identities")
}

model Pipeline {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean @default(false) @map("is_default")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stages PipelineStage[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("pipelines")
}

model PipelineStage {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  pipelineId String @map("pipeline_id") @db.Uuid
  name       String
  position   Int

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite FK keeps a stage's pipeline within the same tenant.
  pipeline Pipeline @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Cascade)
  leads    Lead[]

  @@unique([tenantId, id])
  @@unique([tenantId, pipelineId, position])
  @@map("pipeline_stages")
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  contactId       String     @map("contact_id") @db.Uuid
  pipelineStageId String     @map("pipeline_stage_id") @db.Uuid
  status          LeadStatus @default(OPEN)
  source          String?
  interest        String?
  // Opportunity value in cents (integer, avoids float rounding). Nullable: a
  // lead may exist before a value is estimated. Feeds pipelineValue / monthlySales.
  amountCents     Int?       @map("amount_cents")
  ownerUserId     String?    @map("owner_user_id") @db.Uuid
  nextActionAt    DateTime?  @map("next_action_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact        Contact         @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  pipelineStage  PipelineStage   @relation(fields: [tenantId, pipelineStageId], references: [tenantId, id], onDelete: Restrict)
  // Nullable owner preserved. Composite FK keeps the owner in the same tenant.
  // NoAction (not SetNull) because the composite FK includes the NON-nullable
  // tenantId, which cannot be nulled. The application reassigns/clears
  // ownerUserId (within the tenant's RLS scope) before removing a user.
  owner          User?           @relation("LeadOwner", fields: [tenantId, ownerUserId], references: [tenantId, id], onDelete: NoAction)
  conversations  Conversation[]
  followUps      FollowUp[]
  calendarEvents CalendarEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, pipelineStageId])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerUserId, nextActionAt])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Follow-ups & Calendar (real entities — Lead.nextActionAt kept temporarily
// as a compatibility mirror; these tables are the new source of truth).
// ---------------------------------------------------------------------------

model FollowUp {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  leadId      String           @map("lead_id") @db.Uuid
  ownerUserId String?          @map("owner_user_id") @db.Uuid
  title       String
  description String?
  type        FollowUpType     @default(OTHER)
  priority    FollowUpPriority @default(MEDIUM)
  status      FollowUpStatus   @default(PENDING)
  scheduledAt DateTime         @map("scheduled_at")
  completedAt DateTime?        @map("completed_at")
  canceledAt  DateTime?        @map("canceled_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite FK: a follow-up cannot attach to a lead of another tenant.
  lead   Lead   @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)
  // Nullable owner, same NoAction reasoning as Lead.owner (composite FK carries
  // the non-nullable tenantId, so it cannot be SetNull).
  owner  User?  @relation("FollowUpOwner", fields: [tenantId, ownerUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, ownerUserId, scheduledAt])
  @@index([tenantId, leadId])
  @@map("follow_ups")
}

model CalendarEvent {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  leadId      String?             @map("lead_id") @db.Uuid
  ownerUserId String?             @map("owner_user_id") @db.Uuid
  title       String
  description String?
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)
  startsAt    DateTime            @map("starts_at")
  endsAt      DateTime?           @map("ends_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Optional link to a Lead, kept within the same tenant via composite FK.
  // NoAction for the same reason as Conversation.lead: the composite FK's
  // tenantId is non-nullable, so it cannot be SetNull.
  lead   Lead?  @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: NoAction)
  owner  User?  @relation("CalendarEventOwner", fields: [tenantId, ownerUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, ownerUserId, startsAt])
  @@index([tenantId, leadId])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Conversations & Messages
// ---------------------------------------------------------------------------

model Conversation {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  contactId              String              @map("contact_id") @db.Uuid
  leadId                 String?             @map("lead_id") @db.Uuid
  state                  ConversationState   @default(AI_ATENDENDO)
  channel                ConversationChannel @default(MANUAL)
  assignedUserId         String?             @map("assigned_user_id") @db.Uuid
  subject                String?
  // Stable thread/session id from providers that hand out one (Webchat
  // session, Instagram/Facebook thread). Null for WhatsApp (phone-threaded,
  // no provider conversation id) and MANUAL. Lets ingestion anchor reuse
  // precisely for channels that have their own session boundary, instead of
  // relying only on the "latest open conversation for this contact" heuristic.
  externalConversationId String?             @map("external_conversation_id")
  // Denormalized from the latest Message so the conversation list can sort
  // without aggregating the messages table on every request. Kept in sync by
  // the application whenever a Message is created.
  lastMessageAt          DateTime?           @map("last_message_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact      Contact   @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  // Optional link to a Lead, kept within the same tenant via composite FK.
  // NoAction (not SetNull) for the same reason as Lead.owner: tenantId in the
  // composite FK is non-nullable. The application clears leadId within tenant
  // scope before deleting a Lead.
  lead         Lead?     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: NoAction)
  // Nullable owner, same NoAction reasoning as Lead.owner (composite FK carries
  // the non-nullable tenantId, so it cannot be SetNull).
  assignedUser User?     @relation("ConversationAssignee", fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: NoAction)
  messages     Message[]

  @@unique([tenantId, id])
  // Uniqueness of (tenantId, channel, externalConversationId) is NOT declared
  // here: it applies only to conversations that are not ENCERRADA, and Prisma
  // cannot express a partial unique index. It is the hand-written index
  // conversations_open_external_conversation_id (see migration
  // 20260921121609_partial_external_conversation_id_unique), the same way
  // conversations_open_per_contact_channel is. Consequently there is no
  // generated `tenantId_channel_externalConversationId` unique input: look a
  // thread up with findFirst({ tenantId, channel, externalConversationId,
  // state: { not: ENCERRADA } }).
  @@index([tenantId, state, updatedAt])
  @@index([tenantId, state, lastMessageAt])
  @@index([tenantId, assignedUserId, state])
  @@index([tenantId, channel])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  direction      MessageDirection
  status         MessageStatus     @default(PENDING)
  senderType     MessageSenderType @default(CUSTOMER) @map("sender_type")
  senderUserId   String?           @map("sender_user_id") @db.Uuid
  externalId     String?           @map("external_id")
  body           String?
  createdAt      DateTime          @default(now()) @map("created_at")

  // -- Outbound delivery state (see migration add_outbound_delivery_state) ----
  // Meaningful only for OUTBOUND messages that go to an external provider;
  // NULL / 0 everywhere else (inbound, MANUAL, and historical rows). Column
  // CHECK constraints (hand-written SQL, Prisma cannot express them) enforce:
  // only PENDING OUTBOUND rows may be queued or leased, lease token and expiry
  // come as a pair, attempts are never negative.
  //
  // nextAttemptAt: NULL = not in the delivery queue. Set = eligible from then.
  //   The writer that creates a deliverable message sets it to "now"; a retry
  //   pushes it forward (backoff); a terminal state clears it.
  nextAttemptAt    DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  // Incremented when a delivery attempt is CLAIMED (before the provider is
  // called), so an attempt that dies mid-flight is still counted.
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  // Lease: the worker that claimed the message holds it until leaseExpiresAt.
  // Only the holder of leaseToken may finalize (compare-and-set). An expired
  // lease makes the message claimable again (crash recovery).
  leaseToken       String?   @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  // Short machine code (e.g. TIMEOUT, LEASE_EXPIRED). Never provider text.
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(64)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite FK: a message cannot attach to a conversation of another tenant.
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  // Set only for senderType AGENT/SYSTEM authored by a real user. Nullable
  // owner, same NoAction reasoning as Lead.owner (composite FK carries the
  // non-nullable tenantId, so it cannot be SetNull).
  senderUser   User?        @relation("MessageSender", fields: [tenantId, senderUserId], references: [tenantId, id], onDelete: NoAction)

  // Idempotency for provider-delivered messages (e.g. WhatsApp) per tenant.
  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}
