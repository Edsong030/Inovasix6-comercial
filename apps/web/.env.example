# Copy to apps/web/.env.local. Only NEXT_PUBLIC_* values reach the browser —
# never put secrets here.

# Origin of the Nest API. Routes are called as `${NEXT_PUBLIC_API_URL}/api/...`.
# Must be listed in the API's WEB_ORIGIN CORS allow-list for credentialed
# requests (the HttpOnly refresh cookie) to work.
NEXT_PUBLIC_API_URL=http://localhost:3001
